<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- First-run tour (ui/SpotlightView): shown once after the disclaimer, and from the menu item. -->
    <string name="menu_guide">使用教學</string>
    <string name="guide_skip">略過</string>
    <string name="guide_1_title">這是什麼</string>
    <string name="guide_1_body">用模擬走路依序巡 Pikmin Bloom 的大花、把步數寫進 Health Connect、隨時回家。</string>
    <string name="tour_2_title">選單</string>
    <string name="tour_2_body">先到選單 →「初始設定」逐項打勾，沒做完不會動。</string>
    <string name="tour_3_title">加一朵大花</string>
    <string name="tour_3_body">在地圖上長按，加一朵大花（也可以從選單「搜尋附近候選大花」帶入）。</string>
    <string name="tour_4_title">開始巡邏</string>
    <string name="tour_4_body">按下後，就會開始照巡邏路線巡邏。</string>
    <string name="tour_4_fallback_body">沒在巡邏時，主畫面下方會有『開始巡邏』按鈕；按下後，就會開始照巡邏路線巡邏。</string>
    <string name="tour_homes_title">家的位置</string>
    <string name="tour_homes_body">選單 →『家的位置…』可以存幾個『家』（例如常去的據點）。按『回家』時可以選擇走回真實位置或某個家；到了就停在那裡。開始巡邏永遠從真實位置出發，不會瞬移到家。</string>
    <string name="tour_modes_title">點大花之後</string>
    <string name="tour_modes_body">點地圖上的大花會出現選單：\n立刻前往：走過去，到了繼續巡邏\n前往後停在這裡：走過去，到了就暫停\n瞬移：立刻出現在那裡（遊戲會看到一次瞬移）</string>
    <string name="demo_go_now">立刻前往</string>
    <string name="demo_go_and_stay">前往後停在這裡</string>
    <string name="demo_teleport">瞬移（遊戲會看到一次瞬移）</string>
    <string name="go_modes_ok">知道了</string>
    <string name="hint_go_now">走過去，到了繼續巡邏</string>
    <string name="hint_start_here">從真實位置走過來，之後照路線巡邏</string>
    <string name="hint_go_and_stay">走過去，到了就暫停</string>
    <string name="hint_start_and_stay">從真實位置出發，走過去，到了就暫停</string>
    <string name="hint_teleport_now">立刻出現在那裡（遊戲會看到一次瞬移）</string>
    <string name="hint_teleport_here">瞬移到這裡，然後開始巡邏（遊戲會看到一次瞬移）</string>
    <string name="tour_5a_title">浮動列把手</string>
    <string name="tour_5a_body">這是浮動列的把手：點一下展開，按住可以拖動。\n▶ 暫停／繼續、🏠 回家、■ 停止、🎮 搖桿…</string>
    <string name="tour_5a_fallback_body">開始巡邏後，畫面上會出現浮動列，裡面有暫停、回家、停止等控制。</string>
    <string name="tour_5b_title">自動操作</string>
    <string name="tour_5b_body">🤖 自動操作：在遊戲的探險清單按它，自動派果實／花苗；在餵食畫面按它，自動餵精華。第一次要開無障礙服務，停止在通知列。</string>
    <string name="tour_next">下一個</string>
    <string name="tour_done">完成</string>
</resources>
