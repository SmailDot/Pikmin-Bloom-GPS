<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- First-run tour (ui/SpotlightView): shown once after the disclaimer, and from the menu item. -->
    <string name="menu_guide">使用教學</string>
    <string name="guide_skip">略過</string>
    <string name="guide_1_title">這是什麼</string>
    <string name="guide_1_body">用模擬走路依序巡 Pikmin Bloom 的大花、把步數寫進 Health Connect、隨時回家。</string>
    <string name="tour_2_title">選單</string>
    <string name="tour_2_body">先到選單 →「初始設定」逐項打勾，沒做完不會動。</string>
    <string name="tour_3_title">加一朵大花</string>
    <string name="tour_3_body">在地圖上長按，加一朵大花（也可以從選單「搜尋附近候選大花」帶入）。</string>
    <string name="tour_4_title">開始巡邏</string>
    <string name="tour_4_body">按這裡開始巡邏，接著打開遊戲。</string>
    <string name="tour_5_title">浮動列與自動操作</string>
    <string name="tour_5_body">巡邏時會出現浮動列：▶ 暫停／繼續、🏠 回家、■ 停止、🚶 移動方式、速度、🎮 搖桿、◎ 掃描大花、🤖 自動操作、📍 真實位置切換；把手可以拖動。🤖 可在遊戲的探險清單自動派果實／花苗，或在餵食畫面自動餵精華；停止在通知列。</string>
    <string name="tour_next">下一個</string>
    <string name="tour_done">完成</string>
</resources>
