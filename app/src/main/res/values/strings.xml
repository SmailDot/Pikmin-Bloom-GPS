    <!-- ============================ 免責聲明 ============================ -->
    <string name="dlg_disclaimer_title">免責聲明（請務必閱讀）</string>
    <string name="dlg_disclaimer_msg">本 App 會模擬 GPS 位置並把步數寫入 Health Connect。\n\nNiantic 的服務條款明文禁止竄改定位與步數；違規帳號可能被「三振政策」警告、停權 7 天，甚至永久停權。\n\n使用本 App 代表你已了解並自行承擔帳號被處分的全部風險，作者不負任何責任。</string>
    <string name="action_accept">我了解並接受風險</string>
    <string name="action_exit">離開</string>

