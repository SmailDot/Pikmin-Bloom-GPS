<?xml version="1.0" encoding="utf-8"?>
<!-- Strings for the OpenStreetMap candidate search (ui/OverpassSearch.kt). Kept in a separate file
     so it can be edited without touching the main strings.xml. -->
<resources>
    <string name="menu_find_candidates">近くのおおきな花の候補を検索</string>
    <string name="overpass_search_short">近くを検索</string>
    <string name="overpass_title">近くのおおきな花の候補を検索</string>
    <!-- verify: Japanese name for Niantic "Wayspot" (kept in English here) -->
    <string name="overpass_explain">Niantic はおおきな花の座標を公開していません。おおきな花は Wayspot（ポケストップと同じ場所）に咲き、これらの場所の多くは OpenStreetMap に対応するランドマークがあります。\n\nこの機能は近くの記念碑、パブリックアート、寺院や教会、遊び場、公園の施設などを検索し、「候補」としてリストに追加します。実際に当たるのは 3〜6 割ほどです。現地で確認して、おおきな花がなかったものは削除してください。</string>
    <string name="overpass_need_center">どこから探せばよいかまだ分かりません。先にアプリで一度現在地を取得するか、地図を長押ししておおきな花を追加してください。</string>
    <string name="overpass_radius_title">検索範囲</string>
    <string name="overpass_radius_item">半径 %1$d m</string>
    <string name="overpass_search">検索開始</string>
    <string name="overpass_searching">OpenStreetMap を検索中…</string>
    <string name="overpass_none">近くに新しい候補は見つかりませんでした（リストにある場所は除外しています）。</string>
    <string name="overpass_failed_title">検索に失敗しました</string>
    <string name="overpass_failed_msg">OpenStreetMap の検索サービスに接続できません：%1$s\n\nネットワーク接続を確認するか、しばらくしてからもう一度お試しください（公開サービスには利用制限があります）。</string>
    <string name="overpass_pick_title">候補が %1$d 件見つかりました</string>
    <string name="overpass_item">%1$s（%2$.0f m）</string>
    <string name="overpass_toggle_all">すべて選択／解除</string>
    <string name="overpass_add">リストに追加</string>
    <string name="overpass_added">候補を %1$d 件追加しました</string>
</resources>
