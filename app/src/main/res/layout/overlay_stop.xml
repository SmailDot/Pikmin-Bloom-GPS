<?xml version="1.0" encoding="utf-8"?>
<!-- Stop chip for 自動探險 (ui/OverlayService): the only control on screen while a run goes, so it sits
     top-centre, where no expedition tap lands. Its window is added and removed with the run. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btnStopExpedition"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_bar"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_s"
    android:text="@string/expedition_stop_chip"
    android:textColor="@color/overlay_icon"
    android:textSize="14sp"
    android:textStyle="bold" />
